+def test_reduced_stamps_and_solutions(
+    series_rc, conditional_branch, reduced_assembly, analysis, ground_branch
+):
+    """Full equality-constrained DAE and reduced DC/BE/AC solve agree."""
+    model = load_osdi_model(
