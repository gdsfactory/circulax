--- /dev/null
+++ b/tests/test_vacask_resistor_parity.py
@@ -0,0 +1,16 @@
+"""Keep shipped resistor settings consistent across simulation dialects."""
+
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+VACASK_MODELS = ROOT / "ihp/models/vacask/models"
+
+
+def test_converted_resistors_preserve_manual_mismatch_switch() -> None:
+    """Keep deterministic manual offsets identical across both model dialects."""
+    native = (ROOT / "ihp/models/ngspice/models/resistors_mod.lib").read_text()
+    converted = (VACASK_MODELS / "resistors_mod.lib").read_text()
+    pattern = r"\bsw_mman\s*=\s*(\d+)"
+    assert re.findall(pattern, native, re.IGNORECASE) == ["1", "1", "1"]
+    assert re.findall(pattern, converted, re.IGNORECASE) == ["1", "1", "1"]
